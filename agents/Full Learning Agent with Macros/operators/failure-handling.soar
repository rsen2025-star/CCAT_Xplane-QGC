##!
# @file
#
# NEW FILE - recognizes equipment and sensor failures published by Java on
# io.input-link.flightdata.failures, evaluates the aircraft's remaining
# capabilities across vertical lift, forward propulsion, navigation, and
# altitude sensing, and selects/applies appropriate responses in parallel for
# single or multiple simultaneous failures (see FailureInjector.java,
# FailureResponseHandler.java, FailureScenario.java, CopilotTakeoffAgent.java).
#
#   inputs  (io.input-link.flightdata.failures):
#     active-count               number of active injected faults
#     last-injected              most recently injected target or "none"
#     engine-0 .. engine-3       lift rotors (ok | failed)
#     engine-4                   forward pusher prop (ok | failed)
#     gps, imu, lidar            position sensors (ok | bias | drift | freeze | dropout)
#     altimeter                  barometric altimeter (ok | bias | drift | freeze | dropout)
#     radar-altimeter            radar altimeter / AGL (ok | bias | drift | freeze | dropout)
#
#   capabilities (state ^capabilities):
#     lift                       full (4 working) | degraded (3 working) | critical (<=2 working)
#     working-lift-engines       0..4
#     failed-lift-engines        0..4
#     target-descent-throttle    0.75 (full) | 0.90 (degraded) | 1.0 (critical)
#     target-min-descent-lift    0.20 (full) | 0.45 (degraded) | 0.65 (critical)
#     target-min-decel-lift      0.30 (full) | 0.45 (degraded) | 0.65 (critical)
#     pusher                     ok | failed
#     pusher-failed-count        0..1
#     navigation                 full (3 ok) | redundant (2 ok) | single-sensor (1 ok) | lost (0 ok)
#     working-nav-sensors        0..3
#     failed-nav-sensors         0..3
#     preferred-nav-sensor       gps | imu | lidar | none
#     altitude-sensing           full | agl-only | baro-only | lost
#     failed-altimeters          0..2
#     total-active-failures      0..10
#     multi-failure              yes (>=2 active faults) | no (<2 active faults)
#
#   responses (state ^failure-response / io.output-link.failure-response,
#              plus state ^active-failure-response for all parallel responses):
#     nominal                    all systems operating normally
#     switch-position-sensor     active nav sensor failed; switched to a healthy backup sensor
#     use-radar-altimeter        barometric altimeter failed; using radar altimeter (AGL) for climb
#     cautious-vertical-descent  radar altimeter failed; using gentle descent rate (-150 fpm)
#     abort-takeoff              engine or critical sensor failed on the ground; holding throttle 0.0
#     abort-climb-and-land       failure during vertical takeoff climb; descending back to ground
#     precautionary-landing      degraded lift (1 lift rotor out); landing with boosted lift margin
#     forced-vertical-landing    pusher prop or all nav/altimeters lost in cruise; landing in place
#     maintain-wing-borne-cruise >=2 lift rotors failed in cruise with working pusher; staying on wing
#     emergency-descent          both lift and pusher critically failed; max remaining lift descent

echo "\nLoading failure-handling.soar"

##############################################
### INITIALIZATION - create the capability structure and default active
### navigation sensor on the output-link when the agent initializes.
##############################################
sp {apply*initialize*failure-handling
    (state <s> ^operator.name initialize
               ^io.output-link <out>)
-->
    (<s> ^capabilities <cap>)
    (<out> ^sensor-to-use gps)
}

# Mirrors the current primary failure response onto the output-link
# (i-supported, like ^flight-phase in flight-phases.soar).
sp {failure*elaborate*failure-response-output
    (state <s> ^failure-response <resp>
               ^io.output-link <out>)
-->
    (<out> ^failure-response <resp>)
}

# S.CHANGE - AM (M3: parallel multi-failure execution)
# Elaborate ^executing-failure-response yes whenever any failure-handling
# operator is selected so that all non-conflicting responses (recognizing or
# clearing multiple simultaneous faults, switching position sensors, flagging
# unreliable sensors, adapting lift throttle parameters, and cutting a failed
# pusher) execute in parallel within a single decision cycle.
sp {failure*elaborate*executing-failure-response
    (state <s> ^operator.name << recognize-failure clear-failure
                                 adapt-lift-params switch-position-sensor
                                 abort-takeoff abort-climb-and-land
                                 failure-begin-landing cut-failed-pusher-in-decel
                                 maintain-wing-borne-cruise
                                 emergency-all-propulsion-loss
                                 resume-normal-flight >>)
-->
    (<s> ^executing-failure-response yes)
}
# E.CHANGE - AM

##############################################
### FAILURE RECOGNITION - detect when one or more equipment or sensor targets
### on io.input-link.flightdata.failures enter a fault mode, change fault
### mode, or are cleared back to ok. Recognizes, updates, and clears all
### simultaneous faults in parallel in a single decision cycle.
##############################################
sp {failure*propose*recognize-failure*new
    (state <s> ^name takeoff
               ^io.input-link.flightdata.failures <f>)
    (<f> ^{ <target> << engine-0 engine-1 engine-2 engine-3 engine-4
                        gps imu lidar altimeter radar-altimeter >> }
          { <mode> <> ok })
   -(<s> ^recognized-failure.target <target>)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name recognize-failure
         ^target <target>
         ^mode <mode>)
}

sp {failure*propose*recognize-failure*mode-changed
    (state <s> ^name takeoff
               ^io.input-link.flightdata.failures <f>
               ^recognized-failure <rf>)
    (<f> ^{ <target> << engine-0 engine-1 engine-2 engine-3 engine-4
                        gps imu lidar altimeter radar-altimeter >> }
          { <mode> <> ok })
    (<rf> ^target <target>
          ^mode { <old-mode> <> <mode> })
-->
    (<s> ^operator <o> + > =)
    (<o> ^name recognize-failure
         ^target <target>
         ^mode <mode>
         ^old-mode <old-mode>)
}

# S.CHANGE - AM (M3: recognize/update/clear all simultaneous failures in parallel)
sp {failure*apply*recognize-failure*new
    (state <s> ^executing-failure-response yes
               ^io.input-link.flightdata.failures <f>)
    (<f> ^{ <target> << engine-0 engine-1 engine-2 engine-3 engine-4
                        gps imu lidar altimeter radar-altimeter >> }
          { <mode> <> ok })
   -(<s> ^recognized-failure.target <target>)
-->
    (<s> ^recognized-failure <rf>)
    (<rf> ^target <target>
          ^mode <mode>)
    (write (crlf) |[Failure] Recognized | <target> | failure (mode: | <mode> |)|)
}

sp {failure*apply*recognize-failure*mode-changed
    (state <s> ^executing-failure-response yes
               ^io.input-link.flightdata.failures <f>
               ^recognized-failure <rf>)
    (<f> ^{ <target> << engine-0 engine-1 engine-2 engine-3 engine-4
                        gps imu lidar altimeter radar-altimeter >> }
          { <mode> <> ok })
    (<rf> ^target <target>
          ^mode { <old-mode> <> <mode> })
-->
    (<rf> ^mode <old-mode> - <mode> +)
    (write (crlf) |[Failure] Updated | <target> | failure mode: | <old-mode> | -> | <mode>)
}

sp {failure*propose*clear-failure
    (state <s> ^name takeoff
               ^io.input-link.flightdata.failures <f>
               ^recognized-failure <rf>)
    (<rf> ^target <target>
          ^mode <old-mode>)
    (<f> ^<target> ok)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name clear-failure
         ^target <target>
         ^failure <rf>
         ^old-mode <old-mode>)
}

sp {failure*apply*clear-failure
    (state <s> ^executing-failure-response yes
               ^io.input-link.flightdata.failures <f>
               ^recognized-failure <rf>)
    (<rf> ^target <target>
          ^mode <old-mode>)
    (<f> ^<target> ok)
-->
    (<s> ^recognized-failure <rf> -)
    (write (crlf) |[Failure] Cleared | <target> | failure (was | <old-mode> |)|)
}

sp {failure*apply*clear-failure*reset-climb-aborted
    (state <s> ^executing-failure-response yes
               ^climb-aborted yes
               ^capabilities.total-active-failures 0)
-->
    (<s> ^climb-aborted yes -)
}
# E.CHANGE - AM

##############################################
### CAPABILITY EVALUATION - elaborate the aircraft's remaining capabilities
### from the active failure state on io.input-link.flightdata.failures.
###
### 1. Vertical Lift (engines 0-3):
###    4 working -> full, 3 working -> degraded, <=2 working -> critical
##############################################
proc generateLiftEngineStatus { indices } {
    foreach idx $indices {
        sp "failure*elaborate*lift-engine-ok*${idx}
            (state <s> ^capabilities <cap>
                       ^io.input-link.flightdata.failures.engine-${idx} ok)
        -->
            (<cap> ^lift-${idx}-failed 0)
        "

        sp "failure*elaborate*lift-engine-failed*${idx}
            (state <s> ^capabilities <cap>
                       ^io.input-link.flightdata.failures.engine-${idx} <> ok)
        -->
            (<cap> ^lift-${idx}-failed 1)
        "
    }
}
generateLiftEngineStatus { 0 1 2 3 }

sp {failure*elaborate*capabilities*lift-counts
    (state <s> ^capabilities <cap>)
    (<cap> ^lift-0-failed <e0>
           ^lift-1-failed <e1>
           ^lift-2-failed <e2>
           ^lift-3-failed <e3>)
-->
    (<cap> ^failed-lift-engines (+ <e0> <e1> <e2> <e3>)
           ^working-lift-engines (- 4 (+ <e0> <e1> <e2> <e3>)))
}

sp {failure*elaborate*capabilities*lift*full
    (state <s> ^capabilities <cap>)
    (<cap> ^failed-lift-engines 0)
-->
    (<cap> ^lift full
           ^target-descent-throttle 0.75
           ^target-min-descent-lift 0.2
           ^target-min-decel-lift 0.3)
}

sp {failure*elaborate*capabilities*lift*degraded
    (state <s> ^capabilities <cap>)
    (<cap> ^failed-lift-engines 1)
-->
    (<cap> ^lift degraded
           ^target-descent-throttle 0.90
           ^target-min-descent-lift 0.45
           ^target-min-decel-lift 0.45)
}

sp {failure*elaborate*capabilities*lift*critical
    (state <s> ^capabilities <cap>)
    (<cap> ^failed-lift-engines >= 2)
-->
    (<cap> ^lift critical
           ^target-descent-throttle 1.0
           ^target-min-descent-lift 0.65
           ^target-min-decel-lift 0.65)
}

##############################################
### 2. Forward Propulsion (engine-4 pusher prop):
###    ok -> full forward cruise and approach speed control
###    failed -> cannot sustain horizontal cruise; must rely on lift rotors
##############################################
sp {failure*elaborate*capabilities*pusher*ok
    (state <s> ^capabilities <cap>
               ^io.input-link.flightdata.failures.engine-4 ok)
-->
    (<cap> ^pusher ok
           ^pusher-failed-count 0)
}

sp {failure*elaborate*capabilities*pusher*failed
    (state <s> ^capabilities <cap>
               ^io.input-link.flightdata.failures.engine-4 <> ok)
-->
    (<cap> ^pusher failed
           ^pusher-failed-count 1)
}

##############################################
### 3. Position / Navigation Sensors (gps, imu, lidar):
###    3 working -> full, 2 working -> redundant, 1 working -> single-sensor,
###    0 working -> lost. Also selects the highest-priority healthy sensor.
##############################################
proc generateNavSensorStatus { sensors } {
    foreach sensor $sensors {
        sp "failure*elaborate*nav-sensor-ok*${sensor}
            (state <s> ^capabilities <cap>
                       ^io.input-link.flightdata.failures.${sensor} ok)
        -->
            (<cap> ^${sensor}-status ok
                   ^${sensor}-ok 1)
        "

        sp "failure*elaborate*nav-sensor-failed*${sensor}
            (state <s> ^capabilities <cap>
                       ^io.input-link.flightdata.failures.${sensor} <> ok)
        -->
            (<cap> ^${sensor}-status failed
                   ^${sensor}-ok 0)
        "
    }
}
generateNavSensorStatus { gps imu lidar }

sp {failure*elaborate*capabilities*nav-count
    (state <s> ^capabilities <cap>)
    (<cap> ^gps-ok <g>
           ^imu-ok <i>
           ^lidar-ok <l>)
-->
    (<cap> ^working-nav-sensors (+ <g> <i> <l>)
           ^failed-nav-sensors (- 3 (+ <g> <i> <l>)))
}

sp {failure*elaborate*capabilities*navigation*full
    (state <s> ^capabilities <cap>)
    (<cap> ^working-nav-sensors 3)
-->
    (<cap> ^navigation full)
}

sp {failure*elaborate*capabilities*navigation*redundant
    (state <s> ^capabilities <cap>)
    (<cap> ^working-nav-sensors 2)
-->
    (<cap> ^navigation redundant)
}

sp {failure*elaborate*capabilities*navigation*single-sensor
    (state <s> ^capabilities <cap>)
    (<cap> ^working-nav-sensors 1)
-->
    (<cap> ^navigation single-sensor)
}

sp {failure*elaborate*capabilities*navigation*lost
    (state <s> ^capabilities <cap>)
    (<cap> ^working-nav-sensors 0)
-->
    (<cap> ^navigation lost
           ^preferred-nav-sensor none)
}

sp {failure*elaborate*capabilities*preferred-nav-sensor*gps
    (state <s> ^capabilities <cap>)
    (<cap> ^gps-status ok)
-->
    (<cap> ^preferred-nav-sensor gps)
}

sp {failure*elaborate*capabilities*preferred-nav-sensor*imu
    (state <s> ^capabilities <cap>)
    (<cap> ^gps-status failed
           ^imu-status ok)
-->
    (<cap> ^preferred-nav-sensor imu)
}

sp {failure*elaborate*capabilities*preferred-nav-sensor*lidar
    (state <s> ^capabilities <cap>)
    (<cap> ^gps-status failed
           ^imu-status failed
           ^lidar-status ok)
-->
    (<cap> ^preferred-nav-sensor lidar)
}

##############################################
### 4. Altitude Sensing (altimeter and radar-altimeter):
###    both ok -> full, radar only -> agl-only, baro only -> baro-only,
###    neither ok -> lost
##############################################
sp {failure*elaborate*capabilities*altitude*full
    (state <s> ^capabilities <cap>
               ^io.input-link.flightdata.failures <f>)
    (<f> ^altimeter ok
         ^radar-altimeter ok)
-->
    (<cap> ^altitude-sensing full
           ^failed-altimeters 0)
}

sp {failure*elaborate*capabilities*altitude*agl-only
    (state <s> ^capabilities <cap>
               ^io.input-link.flightdata.failures <f>)
    (<f> ^altimeter <> ok
         ^radar-altimeter ok)
-->
    (<cap> ^altitude-sensing agl-only
           ^failed-altimeters 1)
}

sp {failure*elaborate*capabilities*altitude*baro-only
    (state <s> ^capabilities <cap>
               ^io.input-link.flightdata.failures <f>)
    (<f> ^altimeter ok
         ^radar-altimeter <> ok)
-->
    (<cap> ^altitude-sensing baro-only
           ^failed-altimeters 1)
}

sp {failure*elaborate*capabilities*altitude*lost
    (state <s> ^capabilities <cap>
               ^io.input-link.flightdata.failures <f>)
    (<f> ^altimeter <> ok
         ^radar-altimeter <> ok)
-->
    (<cap> ^altitude-sensing lost
           ^failed-altimeters 2)
}

# S.CHANGE - AM (M3: aggregate multi-failure count and parallel failure flag)
##############################################
### 5. Compound / Multi-Failure Aggregation:
###    Computes total active failures across all four subsystems and flags
###    when multiple component failures are active in parallel.
##############################################
sp {failure*elaborate*capabilities*total-active-failures
    (state <s> ^capabilities <cap>)
    (<cap> ^failed-lift-engines <fle>
           ^pusher-failed-count <pfc>
           ^failed-nav-sensors <fns>
           ^failed-altimeters <fa>)
-->
    (<cap> ^total-active-failures (+ <fle> <pfc> <fns> <fa>))
}

sp {failure*elaborate*capabilities*multi-failure*yes
    (state <s> ^capabilities <cap>)
    (<cap> ^total-active-failures >= 2)
-->
    (<cap> ^multi-failure yes)
}

sp {failure*elaborate*capabilities*multi-failure*no
    (state <s> ^capabilities <cap>)
    (<cap> ^total-active-failures < 2)
-->
    (<cap> ^multi-failure no)
}
# E.CHANGE - AM

##############################################
### RESPONSE DETERMINATION (ELABORATIONS) - derive control flags, all
### concurrently active responses (^active-failure-response), and the
### governing ^failure-response summary from the aircraft's capabilities.
##############################################

# When the barometric altimeter has failed but the radar altimeter is ok,
# use AGL instead of barometric altitude to judge takeoff climb height.
sp {failure*elaborate*altitude-fallback*agl
    (state <s> ^capabilities.altitude-sensing agl-only)
-->
    (<s> ^altitude-fallback agl)
}

# When the radar altimeter has failed (AGL untrusted) or lift is degraded/critical,
# use the gentle low descent rate (-150 fpm) throughout the vertical descent.
sp {failure*elaborate*cautious-descent*no-radar-alt
    (state <s> ^capabilities.altitude-sensing << baro-only lost >>)
-->
    (<s> ^cautious-descent yes)
}

sp {failure*elaborate*cautious-descent*degraded-lift
    (state <s> ^capabilities.lift << degraded critical >>)
-->
    (<s> ^cautious-descent yes)
}

# On the ground before takeoff: reject takeoff if any engine or all nav/altimeters failed.
sp {failure*elaborate*abort-takeoff*lift-failed
    (state <s> ^flight-mode vertical
               ^landing no
               ^io.input-link.flightdata.on-ground yes
               ^capabilities.lift << degraded critical >>)
-->
    (<s> ^abort-takeoff yes)
}

sp {failure*elaborate*abort-takeoff*pusher-failed
    (state <s> ^flight-mode vertical
               ^landing no
               ^io.input-link.flightdata.on-ground yes
               ^capabilities.pusher failed)
-->
    (<s> ^abort-takeoff yes)
}

sp {failure*elaborate*abort-takeoff*nav-lost
    (state <s> ^flight-mode vertical
               ^landing no
               ^io.input-link.flightdata.on-ground yes
               ^capabilities.navigation lost)
-->
    (<s> ^abort-takeoff yes)
}

sp {failure*elaborate*abort-takeoff*altitude-lost
    (state <s> ^flight-mode vertical
               ^landing no
               ^io.input-link.flightdata.on-ground yes
               ^capabilities.altitude-sensing lost)
-->
    (<s> ^abort-takeoff yes)
}

# Airborne in vertical climb: abort climb and land if lift, pusher, all nav, or all altimeters fail.
sp {failure*elaborate*abort-climb*lift-failed
    (state <s> ^flight-mode vertical
               ^landing << no abort >>
               ^io.input-link.flightdata.on-ground no
               ^capabilities.lift << degraded critical >>)
-->
    (<s> ^abort-climb yes)
}

sp {failure*elaborate*abort-climb*pusher-failed
    (state <s> ^flight-mode vertical
               ^landing << no abort >>
               ^io.input-link.flightdata.on-ground no
               ^capabilities.pusher failed)
-->
    (<s> ^abort-climb yes)
}

sp {failure*elaborate*abort-climb*nav-lost
    (state <s> ^flight-mode vertical
               ^landing << no abort >>
               ^io.input-link.flightdata.on-ground no
               ^capabilities.navigation lost)
-->
    (<s> ^abort-climb yes)
}

sp {failure*elaborate*abort-climb*altitude-lost
    (state <s> ^flight-mode vertical
               ^landing << no abort >>
               ^io.input-link.flightdata.on-ground no
               ^capabilities.altitude-sensing lost)
-->
    (<s> ^abort-climb yes)
}

# In horizontal flight with >=2 lift rotors failed but a working pusher prop:
# the aircraft cannot hover, so it must stay wing-borne on the pusher.
sp {failure*elaborate*maintain-wing-borne
    (state <s> ^flight-mode horizontal
               ^capabilities <cap>)
    (<cap> ^lift critical
           ^pusher ok)
-->
    (<s> ^maintain-wing-borne yes)
}

# S.CHANGE - AM (M3: track all simultaneously active failure responses in parallel)
sp {failure*elaborate*active-response*switch-position-sensor
    (state <s> ^capabilities.navigation << redundant single-sensor >>)
-->
    (<s> ^active-failure-response switch-position-sensor)
}

sp {failure*elaborate*active-response*use-radar-altimeter
    (state <s> ^capabilities.altitude-sensing agl-only)
-->
    (<s> ^active-failure-response use-radar-altimeter)
}

sp {failure*elaborate*active-response*cautious-vertical-descent
    (state <s> ^cautious-descent yes)
-->
    (<s> ^active-failure-response cautious-vertical-descent)
}

sp {failure*elaborate*active-response*primary
    (state <s> ^failure-response <resp>)
-->
    (<s> ^active-failure-response <resp>)
}
# E.CHANGE - AM

# Elaborate the governing ^failure-response summary on the state (mutually
# exclusive and exhaustive across all single and multi-failure combinations).
sp {failure*elaborate*response*nominal
    (state <s> -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation full
           ^altitude-sensing full)
-->
    (<s> ^failure-response nominal)
}

sp {failure*elaborate*response*abort-takeoff
    (state <s> ^abort-takeoff yes)
-->
    (<s> ^failure-response abort-takeoff)
}

sp {failure*elaborate*response*abort-climb-and-land
    (state <s> -^abort-takeoff yes
               ^abort-climb yes)
-->
    (<s> ^failure-response abort-climb-and-land)
}

# S.CHANGE - AM (M3: keep abort-climb-and-land response active during the aborted climb descent)
sp {failure*elaborate*response*abort-climb-and-land*descending
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
                ^climb-aborted yes
                ^capabilities.total-active-failures > 0)
-->
    (<s> ^failure-response abort-climb-and-land)
}
# E.CHANGE - AM

sp {failure*elaborate*response*maintain-wing-borne-cruise
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
                ^maintain-wing-borne yes)
-->
    (<s> ^failure-response maintain-wing-borne-cruise)
}

sp {failure*elaborate*response*emergency-descent
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift critical
           ^pusher failed)
-->
    (<s> ^failure-response emergency-descent)
}

# S.CHANGE - AM (M3: critical lift loss while already in vertical descent)
sp {failure*elaborate*response*emergency-descent*vertical-critical-lift
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
                ^flight-mode vertical
                ^capabilities <cap>)
    (<cap> ^lift critical
           ^pusher ok)
-->
    (<s> ^failure-response emergency-descent)
}
# E.CHANGE - AM

sp {failure*elaborate*response*forced-vertical-landing*pusher
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift << full degraded >>
           ^pusher failed)
-->
    (<s> ^failure-response forced-vertical-landing)
}

sp {failure*elaborate*response*forced-vertical-landing*sensors
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift << full degraded >>
           ^pusher ok
           ^navigation lost)
-->
    (<s> ^failure-response forced-vertical-landing)
}

sp {failure*elaborate*response*forced-vertical-landing*altimeters
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift << full degraded >>
           ^pusher ok
           ^navigation <> lost
           ^altitude-sensing lost)
-->
    (<s> ^failure-response forced-vertical-landing)
}

sp {failure*elaborate*response*precautionary-landing
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift degraded
           ^pusher ok
           ^navigation <> lost
           ^altitude-sensing <> lost)
-->
    (<s> ^failure-response precautionary-landing)
}

sp {failure*elaborate*response*switch-position-sensor
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation << redundant single-sensor >>
           ^altitude-sensing full)
-->
    (<s> ^failure-response switch-position-sensor)
}

# S.CHANGE - AM (M3: when both a nav sensor and an altimeter are failed in
# parallel, report whichever sensor/altimeter response was most recently
# triggered while executing both fallbacks concurrently)
sp {failure*elaborate*response*switch-position-sensor*parallel-altimeter
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^io.input-link.flightdata.failures.last-injected << gps imu lidar >>
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation << redundant single-sensor >>
           ^altitude-sensing << agl-only baro-only >>)
-->
    (<s> ^failure-response switch-position-sensor)
}

sp {failure*elaborate*response*use-radar-altimeter*altitude-only
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation full
           ^altitude-sensing agl-only)
-->
    (<s> ^failure-response use-radar-altimeter)
}

sp {failure*elaborate*response*use-radar-altimeter*parallel-nav
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^io.input-link.flightdata.failures.last-injected { <last> <> gps <> imu <> lidar }
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation << redundant single-sensor >>
           ^altitude-sensing agl-only)
-->
    (<s> ^failure-response use-radar-altimeter)
}

sp {failure*elaborate*response*cautious-vertical-descent*altitude-only
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation full
           ^altitude-sensing baro-only)
-->
    (<s> ^failure-response cautious-vertical-descent)
}

sp {failure*elaborate*response*cautious-vertical-descent*parallel-nav
    (state <s> -^abort-takeoff yes
               -^abort-climb yes
               -^climb-aborted yes
               ^io.input-link.flightdata.failures.last-injected { <last> <> gps <> imu <> lidar }
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation << redundant single-sensor >>
           ^altitude-sensing baro-only)
-->
    (<s> ^failure-response cautious-vertical-descent)
}
# E.CHANGE - AM

##############################################
### RESPONSE 1: POSITION SENSOR SWITCHING & PARALLEL UNRELIABLE FLAGGING
### When the currently selected position sensor on the output-link fails and
### at least one healthy backup sensor remains, switch ^sensor-to-use to the
### preferred healthy sensor and flag all faulty position sensors as
### unreliable in parallel.
##############################################
sp {failure*propose*switch-position-sensor
    (state <s> ^capabilities <cap>
               ^io.output-link <out>)
    (<out> ^sensor-to-use <current>)
    (<cap> ^<current>-status failed
           ^navigation << redundant single-sensor >>
           ^preferred-nav-sensor { <backup> <> none <> <current> })
-->
    (<s> ^operator <o> + > =)
    (<o> ^name switch-position-sensor
         ^from <current>
         ^to <backup>)
}

# S.CHANGE - AM (M3: execute sensor failover and multi-sensor unreliable flags
# in parallel with any active failure-handling operator)
sp {failure*apply*switch-position-sensor
    (state <s> ^executing-failure-response yes
               ^capabilities <cap>
               ^io.output-link <out>)
    (<out> ^sensor-to-use <current>)
    (<cap> ^<current>-status failed
           ^navigation { <nav> << redundant single-sensor >> }
           ^preferred-nav-sensor { <backup> <> none <> <current> })
-->
    (<out> ^sensor-to-use <current> - <backup> +)
    (write (crlf) |[Failure Response] Sensor | <current> | failed -> switching navigation to | <backup> | (capability: | <nav> |)|)
}

sp {failure*apply*switch-position-sensor*alert
    (state <s> ^executing-failure-response yes
               ^capabilities <cap>
               ^io.output-link <out>)
    (<out> ^sensor-to-use <current>
           ^alert-sensor-error { <old> <> <current> })
    (<cap> ^<current>-status failed
           ^navigation << redundant single-sensor >>
           ^preferred-nav-sensor { <backup> <> none <> <current> })
-->
    (<out> ^alert-sensor-error <old> - <current> +)
}

sp {failure*apply*mark-gps-unreliable
    (state <s> ^executing-failure-response yes
               ^capabilities.gps-status failed
               ^io.output-link <out>)
   -(<out> ^GPSUnreliable yes)
-->
    (<out> ^GPSUnreliable yes)
}

sp {failure*apply*mark-imu-unreliable
    (state <s> ^executing-failure-response yes
               ^capabilities.imu-status failed
               ^io.output-link <out>)
   -(<out> ^IMUUnreliable yes)
-->
    (<out> ^IMUUnreliable yes)
}

sp {failure*apply*mark-lidar-unreliable
    (state <s> ^executing-failure-response yes
               ^capabilities.lidar-status failed
               ^io.output-link <out>)
   -(<out> ^LIDARUnreliable yes)
-->
    (<out> ^LIDARUnreliable yes)
}

sp {failure*apply*clear-gps-unreliable
    (state <s> ^executing-failure-response yes
               ^capabilities.gps-status ok
               ^io.output-link <out>)
    (<out> ^GPSUnreliable yes)
-->
    (<out> ^GPSUnreliable yes -)
}

sp {failure*apply*clear-imu-unreliable
    (state <s> ^executing-failure-response yes
               ^capabilities.imu-status ok
               ^io.output-link <out>)
    (<out> ^IMUUnreliable yes)
-->
    (<out> ^IMUUnreliable yes -)
}

sp {failure*apply*clear-lidar-unreliable
    (state <s> ^executing-failure-response yes
               ^capabilities.lidar-status ok
               ^io.output-link <out>)
    (<out> ^LIDARUnreliable yes)
-->
    (<out> ^LIDARUnreliable yes -)
}
# E.CHANGE - AM

##############################################
### RESPONSE 2: ADAPT LIFT THROTTLE PARAMETERS FOR REMAINING LIFT CAPABILITY
### With 1 lift rotor out (degraded, 3 of 4 rotors working) or >=2 out
### (critical), raise the descent and minimum lift throttle settings so the
### remaining rotors supply enough thrust to hold pitch while slowing and
### arrest sink rate during vertical descent. Applies in parallel with any
### active failure-handling operator and restores defaults when all 4 are ok.
##############################################
sp {failure*propose*adapt-lift-params
    (state <s> ^capabilities <cap>
               ^params <p>)
    (<cap> ^lift <mode>
           ^target-descent-throttle <new-dt>
           ^target-min-descent-lift <new-mdl>
           ^target-min-decel-lift <new-mdcl>)
    (<p> ^descent-throttle { <dt> <> <new-dt> })
-->
    (<s> ^operator <o> + > =)
    (<o> ^name adapt-lift-params
         ^mode <mode>
         ^descent-throttle <new-dt>
         ^min-descent-lift <new-mdl>
         ^min-decel-lift <new-mdcl>)
}

# S.CHANGE - AM (M3: adapt lift params and raise active throttle floor in parallel)
sp {failure*apply*adapt-lift-params*descent-throttle
    (state <s> ^executing-failure-response yes
               ^capabilities <cap>
               ^params <p>)
    (<cap> ^lift <mode>
           ^target-descent-throttle <new-dt>
           ^target-min-descent-lift <new-mdl>)
    (<p> ^descent-throttle { <old-dt> <> <new-dt> })
-->
    (<p> ^descent-throttle <old-dt> - <new-dt> +)
    (write (crlf) |[Failure Response] Adjusted lift parameters for | <mode> | lift capability (descent-throttle: | <new-dt> |, min-lift: | <new-mdl> |)|)
}

sp {failure*apply*adapt-lift-params*min-descent-lift
    (state <s> ^executing-failure-response yes
               ^capabilities.target-min-descent-lift <new-mdl>
               ^params <p>)
    (<p> ^min-descent-lift { <old-mdl> <> <new-mdl> })
-->
    (<p> ^min-descent-lift <old-mdl> - <new-mdl> +)
}

sp {failure*apply*adapt-lift-params*min-decel-lift
    (state <s> ^executing-failure-response yes
               ^capabilities.target-min-decel-lift <new-mdcl>
               ^params <p>)
    (<p> ^min-decel-lift { <old-mdcl> <> <new-mdcl> })
-->
    (<p> ^min-decel-lift <old-mdcl> - <new-mdcl> +)
}

# If a lift rotor fails while already decelerating on approach (or when
# initiating an in-place landing after cruise lift was shed), immediately
# bring the lift throttle up to at least target-min-decel-lift.
sp {failure*apply*adapt-lift-params*boost-decel-throttle
    (state <s> ^executing-failure-response yes
               ^landing decelerate
              -^maintain-wing-borne yes
              -^operator.name << maintain-wing-borne-cruise
                                 emergency-all-propulsion-loss
                                 resume-normal-flight >>
               ^capabilities.target-min-decel-lift <min>
               ^io.output-link <out>)
    (<out> ^throttle { <t> < <min> })
-->
    (<out> ^throttle <t> - <min> +)
}

# If a lift rotor fails while already in vertical-descent, immediately raise
# the lift throttle to target-descent-throttle so the remaining rotors catch
# the aircraft without waiting for incremental 0.02 lift steps.
sp {failure*apply*adapt-lift-params*boost-vertical-descent-throttle
    (state <s> ^executing-failure-response yes
               ^landing vertical-descent
              -^operator.name << abort-takeoff abort-climb-and-land
                                 maintain-wing-borne-cruise
                                 emergency-all-propulsion-loss
                                 resume-normal-flight >>
               ^capabilities <cap>
               ^io.output-link <out>)
    (<cap> ^lift << degraded critical >>
           ^target-descent-throttle <dt>)
    (<out> ^throttle { <t> < <dt> })
-->
    (<out> ^throttle <t> - <dt> +)
}
# E.CHANGE - AM

##############################################
### RESPONSE 3: ALTIMETER & RADAR ALTIMETER FALLBACKS
### - When barometric altimeter fails but radar altimeter is ok
###   (^altitude-fallback agl), transition to horizontal cruise at 2000 ft AGL.
### - When radar altimeter fails or lift is degraded (^cautious-descent yes),
###   hold the slow touchdown descent rate (descent-vs-low, -150 fpm) for
###   the entire vertical descent instead of waiting for AGL <= 300 ft.
### - Continue cruise lift shedding/restoring during non-landing sensor or
###   altimeter fallback responses so the wing transition completes normally.
##############################################
sp {failure*propose*begin-cruise*agl-fallback
    (state <s> ^flight-mode vertical
               ^landing << no abort >>
               ^altitude-fallback agl
              -^abort-climb yes
               ^io.input-link.flightdata.agl >= 2000)
-->
    (<s> ^operator <o> + >)
    (<o> ^name begin-cruise)
    (write (crlf) |[Failure Response] Altimeter failed -> transitioning to cruise using radar altimeter (AGL >= 2000 ft)|)
}

sp {failure*elaborate*lift-target-vs*cautious
    (state <s> ^landing vertical-descent
               ^cautious-descent yes
               ^params.descent-vs-low <v>)
-->
    (<s> ^lift-target-vs <v>)
}

# S.CHANGE - AM (M3: keep cruise lift shedding/restoring active during sensor/altimeter fallbacks)
sp {failure*propose*adjust-lift*cruise-shed*sensor-fallback
    (state <s> ^flight-mode horizontal
               ^landing no
               ^failure-response << switch-position-sensor
                                    use-radar-altimeter
                                    cautious-vertical-descent >>
               ^params <p>
               ^io <io>)
    (<p> ^wing-borne-speed <wbs>
         ^max-cruise-sink <sink>
         ^cruise-shed-step <step>)
    (<io> ^input-link.flightdata <fd>
          ^output-link.throttle { <t> > 0.0 })
    (<fd> ^airspeed >= <wbs>
          ^vertical-speed > <sink>)
-->
    (<s> ^operator <o> + =)
    (<o> ^name adjust-lift
         ^throttle <t>
         ^step <step>)
}

sp {failure*propose*adjust-lift*cruise-restore*sensor-fallback
    (state <s> ^flight-mode horizontal
               ^landing no
               ^failure-response << switch-position-sensor
                                    use-radar-altimeter
                                    cautious-vertical-descent >>
               ^params <p>
               ^io <io>)
    (<p> ^min-wing-speed <mws>
         ^cruise-lift <cl>
         ^lift-step <step>)
    (<io> ^input-link.flightdata.airspeed < <mws>
          ^output-link.throttle { <t> < <cl> })
-->
    (<s> ^operator <o> + =)
    (<o> ^name adjust-lift
         ^throttle <t>
         ^step <step>)
}
# E.CHANGE - AM

##############################################
### RESPONSE 4: ABORT TAKEOFF ON THE GROUND
### If an engine or critical sensor fails while still on the runway before
### liftoff, cut both lift and pusher throttle to 0.0 and stay on the ground.
##############################################
sp {failure*propose*abort-takeoff
    (state <s> ^abort-takeoff yes
               ^io.output-link.throttle > 0.0)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name abort-takeoff)
}

sp {failure*propose*abort-takeoff*pusher
    (state <s> ^abort-takeoff yes
               ^io.output-link.pusher-throttle <> 0.0)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name abort-takeoff)
}

sp {failure*apply*abort-takeoff
    (state <s> ^operator.name abort-takeoff
               ^io.output-link <out>)
    (<out> ^throttle { <t> <> 0.0 })
-->
    (<out> ^throttle <t> - 0.0 +)
    (write (crlf) |[Failure Response] Critical failure on ground -> aborting takeoff, throttle to 0.0|)
}

sp {failure*apply*abort-takeoff*pusher-off
    (state <s> ^operator.name abort-takeoff
               ^io.output-link <out>)
    (<out> ^pusher-throttle { <pt> <> 0.0 })
-->
    (<out> ^pusher-throttle <pt> - 0.0 +)
}

##############################################
### RESPONSE 5: ABORT VERTICAL CLIMB AND LAND VERTICALLY
### If lift degrades, the pusher fails, or all nav/altimeters are lost
### during the vertical takeoff climb (before reaching horizontal cruise),
### stop climbing and transition directly into vertical-descent to land back
### on the runway using the lift rotors.
##############################################
sp {failure*propose*abort-climb-and-land
    (state <s> ^abort-climb yes
               ^flight-mode vertical
               ^landing { <l> << no abort >> })
-->
    (<s> ^operator <o> + > =)
    (<o> ^name abort-climb-and-land)
}

sp {failure*apply*abort-climb-and-land
    (state <s> ^operator.name abort-climb-and-land
               ^landing { <l> << no abort >> }
               ^io.output-link <out>)
-->
    (<s> ^landing <l> - vertical-descent +
         ^emergency-land yes
         ^climb-aborted yes)
    (<out> ^VTOLMode vertical)
    (write (crlf) |[Failure Response] Failure during vertical climb -> aborting climb, starting vertical descent|)
}

sp {failure*apply*abort-climb-and-land*throttle
    (state <s> ^operator.name abort-climb-and-land
               ^capabilities.target-descent-throttle <dt>
               ^io.output-link <out>)
    (<out> ^throttle { <t> <> <dt> })
-->
    (<out> ^throttle <t> - <dt> +)
}

sp {failure*apply*abort-climb-and-land*pusher-off
    (state <s> ^operator.name abort-climb-and-land
               ^io.output-link <out>)
    (<out> ^pusher-throttle { <pt> <> 0.0 })
-->
    (<out> ^pusher-throttle <pt> - 0.0 +)
}

sp {failure*apply*abort-climb-and-land*autopilot-off
    (state <s> ^operator.name abort-climb-and-land
               ^io.output-link <out>)
    (<out> ^autopilot { <ap> <> off })
-->
    (<out> ^autopilot <ap> - off +)
}

sp {failure*apply*abort-climb-and-land*remove-other-vtolmode
    (state <s> ^operator.name abort-climb-and-land
               ^io.output-link <out>)
    (<out> ^VTOLMode { <vmo> <> vertical })
-->
    (<out> ^VTOLMode <vmo> -)
}

##############################################
### RESPONSE 6: PRECAUTIONARY / FORCED IN-PLACE LANDING FROM CRUISE
### In horizontal cruise when vertical lift remains available (full or
### degraded), initiate an immediate in-place landing (^landing decelerate
### with ^emergency-land yes) if one or more of the following occur:
###   - the pusher prop has failed (cannot sustain forward cruise),
###   - 1 lift rotor has failed (degraded lift: land while 3 rotors work),
###   - all 3 position sensors have failed (cannot navigate to destination),
###   - both altimeters have failed (cannot hold safe cruise altitude).
### ^emergency-land yes sets ^target-airspeed 0 immediately so the aircraft
### slows down where it is instead of flying on to the distant waypoint.
##############################################
# S.CHANGE - AM (M3: elaborate all active in-place landing reasons in parallel)
sp {failure*elaborate*in-place-landing-reason*pusher-failed
    (state <s> ^flight-mode horizontal
               ^capabilities <cap>)
    (<cap> ^lift << full degraded >>
           ^pusher failed)
-->
    (<s> ^in-place-landing-reason pusher-failed)
}

sp {failure*elaborate*in-place-landing-reason*degraded-lift
    (state <s> ^flight-mode horizontal
               ^capabilities <cap>)
    (<cap> ^lift degraded
           ^pusher ok)
-->
    (<s> ^in-place-landing-reason degraded-lift)
}

sp {failure*elaborate*in-place-landing-reason*navigation-lost
    (state <s> ^flight-mode horizontal
               ^capabilities <cap>)
    (<cap> ^lift << full degraded >>
           ^navigation lost)
-->
    (<s> ^in-place-landing-reason navigation-lost)
}

sp {failure*elaborate*in-place-landing-reason*altitude-lost
    (state <s> ^flight-mode horizontal
               ^capabilities <cap>)
    (<cap> ^lift << full degraded >>
           ^altitude-sensing lost)
-->
    (<s> ^in-place-landing-reason altitude-sensing-lost)
}

sp {failure*propose*failure-begin-landing
    (state <s> ^flight-mode horizontal
               ^landing no
               ^in-place-landing-reason <reason>)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name failure-begin-landing
         ^reason <reason>)
}

sp {failure*apply*failure-begin-landing
    (state <s> ^operator.name failure-begin-landing
               ^landing no)
-->
    (<s> ^landing no - decelerate +
         ^emergency-land yes)
}

sp {failure*apply*failure-begin-landing*log-reasons
    (state <s> ^operator.name failure-begin-landing
               ^landing no
               ^in-place-landing-reason <reason>)
-->
    (write (crlf) |[Failure Response] Initiating in-place landing due to | <reason> |: slowing down for vertical descent|)
}

# With cruise lift shed to 0.0 during wing-borne cruise, restore lift rotors
# to target-min-decel-lift when starting an in-place failure landing.
sp {failure*apply*failure-begin-landing*restore-lift
    (state <s> ^operator.name failure-begin-landing
               ^capabilities.target-min-decel-lift <min>
               ^io.output-link <out>)
    (<out> ^throttle { <t> < <min> })
-->
    (<out> ^throttle <t> - <min> +)
}

sp {failure*apply*failure-begin-landing*cut-failed-pusher
    (state <s> ^operator.name failure-begin-landing
               ^capabilities.pusher failed
               ^io.output-link <out>)
    (<out> ^pusher-throttle { <pt> <> 0.0 })
-->
    (<out> ^pusher-throttle <pt> - 0.0 +)
}

# If the pusher fails or all navigation/altitude sensors are lost after
# normal approach deceleration has already begun, zero out any failed pusher
# throttle and mark ^emergency-land yes so target-airspeed becomes 0 in place.
sp {failure*propose*cut-failed-pusher-in-decel
    (state <s> ^landing decelerate
               ^capabilities.pusher failed
               ^io.output-link.pusher-throttle { <pt> <> 0.0 })
-->
    (<s> ^operator <o> + > =)
    (<o> ^name cut-failed-pusher-in-decel)
}

sp {failure*propose*cut-failed-pusher-in-decel*nav-lost
    (state <s> ^landing decelerate
              -^emergency-land yes
              -^maintain-wing-borne yes
               ^capabilities.navigation lost)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name cut-failed-pusher-in-decel)
}

sp {failure*propose*cut-failed-pusher-in-decel*altitude-lost
    (state <s> ^landing decelerate
              -^emergency-land yes
              -^maintain-wing-borne yes
               ^capabilities.altitude-sensing lost)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name cut-failed-pusher-in-decel)
}

sp {failure*apply*cut-failed-pusher-in-decel*pusher
    (state <s> ^executing-failure-response yes
               ^landing decelerate
               ^capabilities.pusher failed
               ^io.output-link <out>)
    (<out> ^pusher-throttle { <pt> <> 0.0 })
-->
    (<s> ^emergency-land yes)
    (<out> ^pusher-throttle <pt> - 0.0 +)
    (write (crlf) |[Failure Response] Pusher failed during approach -> cutting pusher throttle to 0.0|)
}

sp {failure*apply*cut-failed-pusher-in-decel*emergency-stop
    (state <s> ^executing-failure-response yes
               ^landing decelerate
              -^emergency-land yes
              -^maintain-wing-borne yes
               ^capabilities <cap>)
    (<cap> ^lift << full degraded >>)
   -{
     (<cap> ^pusher ok
            ^navigation <> lost
            ^altitude-sensing <> lost)
    }
-->
    (<s> ^emergency-land yes)
    (write (crlf) |[Failure Response] Critical propulsion/sensor loss on approach -> stopping in place for vertical descent|)
}
# E.CHANGE - AM

# In an emergency/precautionary in-place landing, target airspeed is 0
# immediately regardless of distance-to-target.
sp {failure*elaborate*target-airspeed*emergency-stop
    (state <s> ^landing decelerate
               ^emergency-land yes)
-->
    (<s> ^target-airspeed 0)
}

##############################################
### RESPONSE 7: MAINTAIN WING-BORNE CRUISE ON CRITICAL LIFT ROTOR LOSS
### When >=2 lift rotors fail in horizontal flight while the pusher prop is
### still working (^maintain-wing-borne yes), the aircraft cannot hover.
### Keep the autopilot and forward pusher on so the wing stays above stall
### speed, cancel any hover deceleration, and shut down the lift rotors so
### asymmetric rotor thrust does not upset roll/pitch.
##############################################
sp {failure*propose*maintain-wing-borne-cruise*cancel-decel
    (state <s> ^maintain-wing-borne yes
               ^landing decelerate)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name maintain-wing-borne-cruise)
}

sp {failure*propose*maintain-wing-borne-cruise*cut-lift-rotors
    (state <s> ^maintain-wing-borne yes
               ^landing no
               ^io.output-link.throttle > 0.0)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name maintain-wing-borne-cruise)
}

# S.CHANGE - AM (M3: also propose if pusher or autopilot is not at cruise setting)
sp {failure*propose*maintain-wing-borne-cruise*ensure-pusher
    (state <s> ^maintain-wing-borne yes
               ^landing no
               ^params.cruise-pusher <cp>
               ^io.output-link.pusher-throttle <> <cp>)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name maintain-wing-borne-cruise)
}

sp {failure*propose*maintain-wing-borne-cruise*ensure-autopilot
    (state <s> ^maintain-wing-borne yes
               ^landing no
               ^io.output-link.autopilot <> on)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name maintain-wing-borne-cruise)
}
# E.CHANGE - AM

sp {failure*apply*maintain-wing-borne-cruise*throttle-off
    (state <s> ^operator.name maintain-wing-borne-cruise
               ^io.output-link <out>)
    (<out> ^throttle { <t> <> 0.0 })
-->
    (<out> ^throttle <t> - 0.0 +)
    (write (crlf) |[Failure Response] Critical lift loss (>=2 lift rotors failed) -> maintaining wing-borne flight on pusher prop|)
}

sp {failure*apply*maintain-wing-borne-cruise*pusher-on
    (state <s> ^operator.name maintain-wing-borne-cruise
               ^params.cruise-pusher <cp>
               ^io.output-link <out>)
    (<out> ^pusher-throttle { <pt> <> <cp> })
-->
    (<out> ^pusher-throttle <pt> - <cp> +)
}

sp {failure*apply*maintain-wing-borne-cruise*autopilot-on
    (state <s> ^operator.name maintain-wing-borne-cruise
               ^io.output-link <out>)
    (<out> ^autopilot { <ap> <> on })
-->
    (<out> ^autopilot <ap> - on +)
}

sp {failure*apply*maintain-wing-borne-cruise*reset-landing
    (state <s> ^operator.name maintain-wing-borne-cruise
               ^landing decelerate)
-->
    (<s> ^landing decelerate - no +)
    (write (crlf) |[Failure Response] Critical lift loss (>=2 lift rotors failed) -> cancelling hover approach, staying wing-borne|)
}

sp {failure*apply*maintain-wing-borne-cruise*clear-emergency-land
    (state <s> ^operator.name maintain-wing-borne-cruise
               ^emergency-land yes)
-->
    (<s> ^emergency-land yes -)
}

##############################################
### RESPONSE 8: EMERGENCY DESCENT ON TOTAL PROPULSION LOSS IN CRUISE
### If both >=2 lift rotors and the pusher prop have failed in horizontal
### flight (or >=2 lift rotors fail after vertical descent has already
### started), neither wing-borne cruise nor normal hover is available.
### Disengage the AP, cut the pusher, and command maximum remaining lift (1.0)
### in vertical-descent to minimize sink rate until touchdown.
##############################################
sp {failure*propose*emergency-all-propulsion-loss
    (state <s> ^flight-mode horizontal
               ^landing { <l> << no decelerate >> }
               ^capabilities <cap>)
    (<cap> ^lift critical
           ^pusher failed)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name emergency-all-propulsion-loss)
}

# S.CHANGE - AM (M3: handle critical lift loss occurring during vertical-descent)
sp {failure*propose*emergency-all-propulsion-loss*in-vertical-descent
    (state <s> ^flight-mode vertical
               ^landing vertical-descent
              -^climb-aborted yes
               ^capabilities.lift critical
               ^io.output-link.throttle < 1.0)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name emergency-all-propulsion-loss)
}
# E.CHANGE - AM

sp {failure*apply*emergency-all-propulsion-loss
    (state <s> ^operator.name emergency-all-propulsion-loss
               ^flight-mode { <fm> <> vertical }
               ^landing { <l> <> vertical-descent })
-->
    (<s> ^flight-mode <fm> - vertical +
         ^landing <l> - vertical-descent +
         ^emergency-land yes)
    (write (crlf) |[Failure Response] Total propulsion loss (critical lift + pusher failed) -> emergency vertical descent at max remaining lift|)
}

sp {failure*apply*emergency-all-propulsion-loss*max-lift
    (state <s> ^operator.name emergency-all-propulsion-loss
               ^io.output-link <out>)
    (<out> ^throttle { <t> <> 1.0 })
-->
    (<out> ^throttle <t> - 1.0 +)
}

sp {failure*apply*emergency-all-propulsion-loss*pusher-off
    (state <s> ^operator.name emergency-all-propulsion-loss
               ^io.output-link <out>)
    (<out> ^pusher-throttle { <pt> <> 0.0 })
-->
    (<out> ^pusher-throttle <pt> - 0.0 +)
}

sp {failure*apply*emergency-all-propulsion-loss*autopilot-off
    (state <s> ^operator.name emergency-all-propulsion-loss
               ^io.output-link <out>)
    (<out> ^autopilot { <ap> <> off })
-->
    (<out> ^autopilot <ap> - off +)
}

sp {failure*apply*emergency-all-propulsion-loss*vtol-vertical
    (state <s> ^operator.name emergency-all-propulsion-loss
               ^io.output-link <out>)
    (<out> ^VTOLMode { <vmo> <> vertical })
-->
    (<out> ^VTOLMode <vmo> - vertical +)
}

##############################################
### RESPONSE 9: RESUME NORMAL CRUISE WHEN FAILURES ARE CLEARED
### If an in-place failure landing (^emergency-land yes) was slowing down in
### horizontal flight and the user clears all landing-critical failures in
### the Failure Panel, resume normal horizontal cruise toward the destination.
##############################################
sp {failure*propose*resume-normal-flight
    (state <s> ^flight-mode horizontal
               ^landing decelerate
               ^emergency-land yes
               ^capabilities <cap>)
    (<cap> ^lift full
           ^pusher ok
           ^navigation <> lost
           ^altitude-sensing <> lost)
-->
    (<s> ^operator <o> + > =)
    (<o> ^name resume-normal-flight)
}

sp {failure*apply*resume-normal-flight
    (state <s> ^operator.name resume-normal-flight
               ^landing decelerate
               ^emergency-land yes)
-->
    (<s> ^landing decelerate - no +
         ^emergency-land yes -)
    (write (crlf) |[Failure Response] Failures cleared -> resuming normal horizontal cruise|)
}

sp {failure*apply*resume-normal-flight*throttle
    (state <s> ^operator.name resume-normal-flight
               ^io.output-link <out>)
    (<out> ^throttle { <t> <> 0.6 })
-->
    (<out> ^throttle <t> - 0.6 +)
}

sp {failure*apply*resume-normal-flight*pusher
    (state <s> ^operator.name resume-normal-flight
               ^params.cruise-pusher <cp>
               ^io.output-link <out>)
    (<out> ^pusher-throttle { <pt> <> <cp> })
-->
    (<out> ^pusher-throttle <pt> - <cp> +)
}

##############################################
### OPERATOR PRECEDENCE - order failure-handling, flight-phase transition,
### navigation, and alert-handling operators so simultaneous proposals never
### tie, even when multiple failures occur in parallel.
##############################################

# 1. Touchdown and pilot abort-landing always take top priority.
sp {failure*compare*touchdown-and-abort-first
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name << touchdown abort-landing >>)
    (<o2> -^name << touchdown abort-landing >>)
-->
    (<s> ^operator <o1> > <o2>)
}

# S.CHANGE - AM (M3: primary failure maneuver operators execute first and trigger
# recognition, sensor failover, and parameter adaptation in parallel on the same cycle)
# 2. Primary failure maneuver operators run next; because they elaborate
# ^executing-failure-response yes, any pending recognize-failure, clear-failure,
# switch-position-sensor, and adapt-lift-params actions fire in parallel during
# the same apply phase.
sp {failure*compare*primary-failure-responses-first
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name << abort-takeoff abort-climb-and-land
                   emergency-all-propulsion-loss maintain-wing-borne-cruise
                   failure-begin-landing cut-failed-pusher-in-decel
                   resume-normal-flight >>)
    (<o2> -^name << touchdown abort-landing abort-takeoff abort-climb-and-land
                    emergency-all-propulsion-loss maintain-wing-borne-cruise
                    failure-begin-landing cut-failed-pusher-in-decel
                    resume-normal-flight >>)
-->
    (<s> ^operator <o1> > <o2>)
}

sp {failure*compare*primary-failure-responses-indifferent
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name << abort-takeoff abort-climb-and-land
                   emergency-all-propulsion-loss maintain-wing-borne-cruise
                   failure-begin-landing cut-failed-pusher-in-decel
                   resume-normal-flight >>)
    (<o2> ^name << abort-takeoff abort-climb-and-land
                   emergency-all-propulsion-loss maintain-wing-borne-cruise
                   failure-begin-landing cut-failed-pusher-in-decel
                   resume-normal-flight >>)
-->
    (<s> ^operator <o1> = <o2>)
}

# 3. Standalone sensor failover, parameter adaptation, and failure recognition
# or clearing run before normal flight and alert operators (and execute all
# pending secondary failure actions in parallel via ^executing-failure-response).
sp {failure*compare*switch-sensor-before-recognition-and-flight
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name switch-position-sensor)
    (<o2> -^name << touchdown abort-landing abort-takeoff abort-climb-and-land
                    emergency-all-propulsion-loss maintain-wing-borne-cruise
                    failure-begin-landing cut-failed-pusher-in-decel
                    resume-normal-flight switch-position-sensor >>)
-->
    (<s> ^operator <o1> > <o2>)
}

sp {failure*compare*recognition-and-params-before-flight
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name << adapt-lift-params recognize-failure clear-failure >>)
    (<o2> -^name << touchdown abort-landing abort-takeoff abort-climb-and-land
                    emergency-all-propulsion-loss maintain-wing-borne-cruise
                    failure-begin-landing cut-failed-pusher-in-decel
                    resume-normal-flight switch-position-sensor
                    adapt-lift-params recognize-failure clear-failure >>)
-->
    (<s> ^operator <o1> > <o2>)
}

sp {failure*compare*recognition-and-params-indifferent
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name << adapt-lift-params recognize-failure clear-failure >>)
    (<o2> ^name << adapt-lift-params recognize-failure clear-failure >>)
-->
    (<s> ^operator <o1> = <o2>)
}

# 4. Normal flight phase transitions take priority over heading updates,
# alert-handling, and continuous throttle/pusher adjustment operators.
sp {failure*compare*flight-transitions-before-navigation-and-alerts
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name << takeoff begin-cruise begin-landing start-vertical-descent >>)
    (<o2> ^name << follow-bearing warn do-not-warn decision record-user-response
                   record-changed-error-gps record-changed-error-lidar
                   record-changed-error-imu adjust-pusher
                   adjust-lift-pitch adjust-lift >>)
-->
    (<s> ^operator <o1> > <o2>)
}

# 5. Heading updates (follow-bearing, which has > preference in flight-phases.soar)
# take priority over alert-handling and continuous throttle/pusher adjustments.
sp {failure*compare*follow-bearing-before-alerts-and-adjustments
    (state <s> ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name follow-bearing)
    (<o2> ^name << warn do-not-warn decision record-user-response
                   record-changed-error-gps record-changed-error-lidar
                   record-changed-error-imu adjust-pusher
                   adjust-lift-pitch adjust-lift >>)
-->
    (<s> ^operator <o1> > <o2>)
}

# 6. When multiple sensors change error simultaneously, prefer warn over
# do-not-warn if any sensor is in a safety warn-condition.
sp {failure*compare*warn-before-do-not-warn*safety
    (state <s> ^{ <err-info> << gps-error-info lidar-error-info imu-error-info >> }.warn-condition safety
               ^operator <o1> +
               ^operator { <o2> <> <o1> } +)
    (<o1> ^name warn)
    (<o2> ^name do-not-warn)
-->
    (<s> ^operator <o1> > <o2>)
}
# E.CHANGE - AM
